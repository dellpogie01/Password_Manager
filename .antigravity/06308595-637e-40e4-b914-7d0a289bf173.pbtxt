          text = strength.name,\\n                        style = MaterialTheme.typography.bodySmall,\\n                        fontWeight = FontWeight.Bold,\\n                        color = when (strength) {\\n                            PasswordStrength.WEAK -> MaterialTheme.colorScheme.error\\n                            PasswordStrength.MEDIUM -> MaterialTheme.colorScheme.secondary\\n                            PasswordStrength.STRONG -> MaterialTheme.colorScheme.primary\\n                        }\\n                    )\\n                }\\n            }\\n\\n            Spacer(modifier = Modifier.height(16.dp))\\n\\n            OutlinedTextField(\\n                value = confirmPassword,\\n                onValueChange = { confirmPassword = it; errorMessage = null },\\n                label = { Text(\\\"Confirm Master Password\\\") },\\n                singleLine = true,\\n                visualTransformation = PasswordVisualTransformation(),\\n                modifier = Modifier.fillMaxWidth()\\n            )\\n\\n            Spacer(modifier = Modifier.height(16.dp))\\n\\n            Row(\\n                modifier = Modifier.fillMaxWidth(),\\n                verticalAlignment = Alignment.CenterVertically\\n            ) {\\n                Checkbox(\\n                    checked = acknowledgmentChecked,\\n                    onCheckedChange = { acknowledgmentChecked = it }\\n                )\\n                Spacer(modifier = Modifier.width(8.dp))\\n                Text(\\n                    text = \\\"I understand there is NO cloud recovery or password reset service. If I forget this password, my data is permanently lost.\\\",\\n                    style = MaterialTheme.typography.bodySmall,\\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\\n                    modifier = Modifier.weight(1f)\\n                )\\n            }\\n\\n            Spacer(modifier = Modifier.height(12.dp))\\n\\n            Row(\\n                modifier = Modifier.fillMaxWidth(),\\n                verticalAlignment = Alignment.CenterVertically\\n            ) {\\n                Checkbox(\\n                    checked = enableBiometric,\\n                    onCheckedChange = { enableBiometric = it }\\n                )\\n                Spacer(modifier = Modifier.width(8.dp))\\n                Text(\\n                    text = \\\"Enable Biometric Unlock (Fingerprint / Face)\\\",\\n                    style = MaterialTheme.typography.bodyMedium,\\n                    color = MaterialTheme.colorScheme.onBackground\\n                )\\n            }\\n\\n            if (errorMessage != null) {\\n                Spacer(modifier = Modifier.height(12.dp))\\n                Text(\\n                    text = errorMessage!!,\\n                    color = MaterialTheme.colorScheme.error,\\n                    style = MaterialTheme.typography.bodyMedium\\n                )\\n            }\\n\\n            Spacer(modifier = Modifier.height(24.dp))\\n\\n            Button(\\n                onClick = {\\n                    if (password.length < 6) {\\n                        errorMessage = \\\"Password must be at least 6 characters long.\\\"\\n                        return@Button\\n                    }\\n                    if (password != confirmPassword) {\\n                        errorMessage = \\\"Passwords do not match.\\\"\\n                        return@Button\\n                    }\\n                    if (!acknowledgmentChecked) {\\n                        errorMessage = \\\"Please confirm you understand there is no password recovery.\\\"\\n                        return@Button\\n                    }\\n                    isSubmitting = true\\n                    scope.launch {\\n                        val success = viewModel.setupVault(password.toCharArray(), enableBiometric)\\n                        isSubmitting = false\\n                        if (success) {\\n                            onVaultCreated()\\n                        } else {\\n                            errorMessage = \\\"Failed to create vault. Please try again.\\\"\\n                        }\\n                    }\\n                },\\n                modifier = Modifier\\n                    .fillMaxWidth()\\n                    .height(50.dp),\\n                enabled = !isSubmitting\\n            ) {\\n                if (isSubmitting) {\\n                    CircularProgressIndicator(modifier = Modifier.size(24.dp), color = MaterialTheme.colorScheme.onPrimary)\\n                } else {\\n                    Text(\\\"Initialize Secure Vault\\\", fontSize = 16.sp, fontWeight = FontWeight.Bold)\\n                }\\n            }\\n        }\\n    }\\n}\\n\", \"Description\":\"Fix typography references in SetupScreen.kt\", \"Overwrite\":true, \"TargetFile\":\"/app/src/main/java/com/example/ui/screens/SetupScreen.kt\", \"toolAction\":\"Fixing SetupScreen.kt\", \"toolSummary\":\"Fix SetupScreen typography\"}"
