            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Data Models**: `VaultEntryEntity` (id, title, username, encryptedPassword, encryptedUrl, category, notes, isFavorite, updatedAt), `VaultMetaEntity` (salt, kdfParams, encryptedVaultKeyMaster, encryptedVaultKeyBiometric, iv)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Clipboard Security**: Copies username/password, sets a 30s coroutine timer that checks if clipboard still holds the copied value before clearing."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Backup / Restore**: Encrypted JSON format containing versioned KDF parameters, salt, and encrypted entry list, protected by a dedicated backup passphrase."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
